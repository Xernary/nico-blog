baseURL = "https://xernary.github.io/nico-blog/"
languageCode = "en-us"
title = "Nico's Security Research"

# Fondamentale per GitHub Pages project site
relativeURLs = true
canonifyURLs = true

# Tema
theme = "PaperMod"

[params]
  defaultTheme = "dark"
  disableThemeToggle = false

  ShowToc = true
  TocOpen = true

  ShowReadingTime = true
  ShowBreadCrumbs = true

[menu]
  [[menu.main]]
    name = "Posts"
    url = "/posts/"
    weight = 1

  [[menu.main]]
    name = "About"
    url = "/about/"
    weight = 2
